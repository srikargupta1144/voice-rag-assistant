# Copy to .env and fill in what you need. Every setting in configs/default.yaml can be
# overridden here as VRA_<GROUP>__<FIELD>. Never commit .env.

# LLM backend: "ollama" (local, default) or "openai" (any OpenAI-compatible hosted API).
VRA_LLM__PROVIDER=ollama
VRA_LLM__MODEL=llama3.2:3b
# VRA_LLM__MODEL=llama3.1:8b              # slower, stronger local option
# VRA_LLM__OLLAMA_URL=http://localhost:11434

# Hosted backend (used when VRA_LLM__PROVIDER=openai)
# VRA_LLM__OPENAI_BASE_URL=https://api.openai.com/v1
# VRA_LLM__OPENAI_MODEL=gpt-4o-mini
# VRA_LLM__API_KEY=                       # or OPENAI_API_KEY

# Vector store: FAISS by default; Pinecone is used automatically when this key is set.
# PINECONE_API_KEY=
# VRA_VECTOR_STORE__PINECONE_INDEX=voice-rag-assistant

# Not-found gate on the cross-encoder score (higher = says "not found" more often)
# VRA_RETRIEVAL__NOT_FOUND_THRESHOLD=1.5

VRA_LOG_LEVEL=INFO
